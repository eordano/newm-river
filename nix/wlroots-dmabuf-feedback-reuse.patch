+static bool feedback_table_matches(const struct wlr_linux_dmabuf_feedback_v1_compiled *compiled,
+		const struct wlr_linux_dmabuf_feedback_v1_table_entry *entries, size_t table_size) {
+	if (compiled->table_size != table_size) {
+		return false;
+	}
+	void *data = mmap(NULL, table_size, PROT_READ, MAP_SHARED, compiled->table_fd, 0);
+	if (data == MAP_FAILED) {
+		return false;
+	}
+	bool match = memcmp(data, entries, table_size) == 0;
+	munmap(data, table_size);
+	return match;
+}
